---
interface Item {
  id: string;
  data: { title: string; description?: string; pubDate: Date; categories?: string[] };
}
interface Props {
  posts: Item[];
  showDate?: boolean;
  kicker?: boolean;
}
const { posts, showDate = true, kicker = true } = Astro.props;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<div class="grid grid-3">
  {posts.map((post) => (
    <a class="card" href={`/${post.id}/`}>
      {kicker && post.data.categories?.[0] && <span class="kicker">{post.data.categories[0]}</span>}
      <h3>{post.data.title}</h3>
      {post.data.description && <p>{post.data.description.slice(0, 130)}{post.data.description.length > 130 ? '…' : ''}</p>}
      {showDate && <span class="date">{fmt(post.data.pubDate)}</span>}
    </a>
  ))}
</div>
