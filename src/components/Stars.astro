---
interface Props {
  score: number;
  label?: string;
}
const { score, label } = Astro.props;
const pct = (Math.max(0, Math.min(5, score)) / 5) * 100;
---
<span class="stars-wrap" role="img" aria-label={label ?? `${score} van 5 sterren`}>
  <span class="stars-base" aria-hidden="true">
    {[0, 1, 2, 3, 4].map(() => (
      <svg viewBox="0 0 20 19"><path d="M10 0l2.7 6.1 6.6.6-5 4.4 1.5 6.5L10 14.2 4.2 17.6l1.5-6.5-5-4.4 6.6-.6z" /></svg>
    ))}
  </span>
  <span class="stars-fill" aria-hidden="true" style={`width:${pct}%`}>
    {[0, 1, 2, 3, 4].map(() => (
      <svg viewBox="0 0 20 19"><path d="M10 0l2.7 6.1 6.6.6-5 4.4 1.5 6.5L10 14.2 4.2 17.6l1.5-6.5-5-4.4 6.6-.6z" /></svg>
    ))}
  </span>
</span>

<style>
  .stars-wrap {
    position: relative;
    display: inline-block;
    vertical-align: -2px;
    line-height: 0;
  }
  .stars-base,
  .stars-fill {
    display: flex;
    gap: 2px;
  }
  .stars-base svg,
  .stars-fill svg {
    width: 13px;
    height: 13px;
    flex: none;
    display: block;
  }
  .stars-base svg path {
    fill: #d9e2e8;
  }
  .stars-fill {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .stars-fill svg path {
    fill: #f0a500;
  }
</style>
