---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina niet gevonden | Uitvaartpolis-online.com" noindex={true}>
  <section class="page-hero">
    <div class="wrap">
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>De pagina die je zocht is verplaatst of verwijderd. Hieronder vind je de meest gebruikte pagina's.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="grid grid-3">
        <a class="tile" href="/"><h3>Uitvaartverzekering vergelijken</h3><p>Start de vergelijking op de homepage.</p></a>
        <a class="tile" href="/kennisbank/"><h3>Kennisbank</h3><p>Alles over uitvaarten, polissen en kosten.</p></a>
        <a class="tile" href="/reviews/"><h3>Reviews</h3><p>Alle verzekeraars beoordeeld.</p></a>
        <a class="tile" href="/begrafenisverzekering/"><h3>Begrafenisverzekering</h3><p>Premies en dekking vergelijken.</p></a>
        <a class="tile" href="/blog/"><h3>Blog</h3><p>Nieuws en achtergrondartikelen.</p></a>
        <a class="tile" href="/contact/"><h3>Contact</h3><p>Neem contact met ons op.</p></a>
      </div>
    </div>
  </section>
</BaseLayout>
