---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareWidget from '../components/CompareWidget.astro';
import PostGrid from '../components/PostGrid.astro';
import Stars from '../components/Stars.astro';

const all = await getCollection('blog');
const byDate = (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const withImage = (p: any) => Boolean(p.data.image);

const blogPosts = all.filter((p) => (p.data.categories ?? []).includes('Blog')).sort(byDate).slice(0, 3);
const kennisbank = all
  .filter((p) => p.id.startsWith('kennisbank/'))
  .sort((a, b) => Number(withImage(b)) - Number(withImage(a)) || byDate(a, b))
  .slice(0, 6);
const steden = all
  .filter((p) => p.id.startsWith('begrafenisondernemer/'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'nl'));
const reviews = all.filter((p) => p.id.startsWith('reviews/'));

/* Cijfers en aanbieders 1-op-1 overgenomen van de bronsite (premie 18-jarige,
   verzekerd bedrag EUR 9.000,-, niet-roker, zonder partner of kinderen). */
const top = [
  { naam: 'DELA', logo: '/wp-content/uploads/2022/03/dela-logo.jpg', pakket: 'In diensten Plus', premie: '7,34', score: 3.8, reviews: 21, href: '/dela-offer/' },
  { naam: 'Monuta', logo: '/wp-content/uploads/2022/03/monuta-logo.jpg', pakket: 'Plus', premie: '6,74', score: 4.1, reviews: 14, href: '/monuta-offer/' },
  { naam: 'DELA', logo: '/wp-content/uploads/2022/03/dela-logo.jpg', pakket: 'In geld', premie: '9,42', score: 3.8, reviews: 21, href: '/dela-offer/' },
];

const trustLogos = [
  { src: '/wp-content/uploads/2022/03/dela-logo.jpg', alt: 'DELA' },
  { src: '/wp-content/uploads/2022/03/monuta-logo.jpg', alt: 'Monuta' },
  { src: '/wp-content/uploads/2022/03/ardanta-logo-post-featured.jpg', alt: 'Ardanta' },
  { src: '/wp-content/uploads/2022/03/yarden-logo.jpg', alt: 'Yarden' },
];

const stappen = [
  { t: 'Vul je gegevens in', p: 'Geboortedatum en gewenst verzekerd bedrag. Meer heb je niet nodig en je laat geen persoonsgegevens achter.' },
  { t: 'Vergelijk alle polissen', p: 'Premie, dekking, voorwaarden en kinderdekking van elke verzekeraar overzichtelijk naast elkaar.' },
  { t: 'Sluit af bij de verzekeraar', p: 'Je regelt het rechtstreeks en veilig op de website van de verzekeraar zelf. Wij zitten er niet tussen.' },
];
---

<BaseLayout
  title="Uitvaartverzekering Vergelijken &amp; Besparen | Beste TOP 5 In 2026"
  description="Vergelijk GRATIS en eenvoudig de BESTE uitvaartverzekering | Bespaar tot wel 800 euro | Vergelijk premie, voorwaarden &amp; dekking"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Uitvaartverzekering vergelijken &amp; in 3 minuten besparen</h1>
        <p class="lead">
          Altijd 100% onafhankelijk de beste uitvaartverzekering vergelijken. Volledige prijzen zonder kleine
          lettertjes en direct maandelijks geld besparen op je premie.
        </p>
        <ul class="usp">
          <li>Alle verzekeraars op één plek</li>
          <li>Zonder je gegevens achter te laten</li>
          <li>100% onafhankelijk</li>
        </ul>
        <div class="cta-row">
          <a class="btn" href="#vergelijken">Vergelijk verzekeringen</a>
          <a class="btn btn-ghost no-arrow" href="/kennisbank/" style="color:#dbe7ee!important;border-color:rgba(255,255,255,.28)">
            Naar de kennisbank
          </a>
        </div>
      </div>

      <div class="rank-card">
        <header>
          <h2>Meest gekozen pakketten</h2>
          <p>Premie voor een 18-jarige, verzekerd bedrag &euro; 9.000,-</p>
        </header>
        {top.map((t, i) => (
          <div class="rank-row">
            <span class="num">{i + 1}</span>
            <span class="brand">
              <img src={t.logo} alt={`${t.naam} logo`} loading="lazy" />
              <span class="meta">
                {t.pakket} &middot; <Stars score={t.score} label={`${t.score} van 5`} /> {t.score.toString().replace('.', ',')} ({t.reviews})
              </span>
            </span>
            <span>
              <span class="price">&euro; {t.premie}</span>
              <span class="per">per maand</span>
            </span>
          </div>
        ))}
        <footer>
          <a class="btn btn-blue" href="#vergelijken">Bekijk alle aanbieders</a>
          <p>Berekend voor een niet-rokende 18-jarige zonder partner of kinderen.</p>
        </footer>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="trust">
        <span class="label">Wij vergelijken onder andere</span>
        {trustLogos.map((l) => <img src={l.src} alt={l.alt} loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="tint" id="vergelijken-sectie">
    <div class="wrap">
      <CompareWidget
        title="Uitvaartverzekering vergelijken"
        intro="De gemiddelde uitvaartkosten zijn dit jaar € 7.500,- en bijna 70% van de Nederlanders is gedekt met een uitvaartverzekering. Vergelijk hieronder premie, dekking en voorwaarden."
      />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Zo werkt het</h2>
        <p class="section-sub">Van vergelijken tot afsluiten in drie stappen &mdash; zonder verkooppraat.</p>
      </div>
      <ol class="steps">
        {stappen.map((s) => (
          <li>
            <h3>{s.t}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="tint">
    <div class="wrap">
      <div class="grid grid-2" style="gap:56px;align-items:start">
        <div class="prose" style="max-width:none">
          <h2 id="wat-is-een-uitvaartverzekering" style="margin-top:0">Wat is een uitvaartverzekering?</h2>
          <p>
            Een uitvaartverzekering is een polis die alle kosten vergoedt die bij een begrafenis of crematie horen.
            Denk bijvoorbeeld aan het werk van een uitvaartondernemer, het rouwdrukwerk, de kist en het vervoer voor
            de begrafenisstoet.
          </p>
          <h3 id="hoe-werkt-een-uitvaartverzekering">Hoe werkt een uitvaartverzekering?</h3>
          <p>
            Een uitvaartverzekering werkt simpel: door een polis af te sluiten worden alle kosten afgedekt en zitten je
            nabestaanden niet met hoge kosten na overlijden. Alle organisatorische werkzaamheden worden uit handen
            genomen. Een uitvaart kost gemiddeld tussen de 6.000 en 10.000 euro. Je betaalt een maandelijkse premie en
            daar krijg je die dekking voor terug.
          </p>
          <p>
            <a href="/begrafenisverzekering/">Begrafenisverzekering vergelijken</a> &middot;
            <a href="/overlijdensrisicoverzekering/">Overlijdensrisicoverzekering</a> &middot;
            <a href="/kennisbank/wat-kost-een-uitvaart/">Wat kost een uitvaart?</a>
          </p>
        </div>

        <div class="grid" style="gap:18px">
          <div class="tile">
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
            </span>
            <h3>Betrouwbaar vergelijken</h3>
            <p>Verschillende verzekeraars, polissen en premies op één plek voor een eerlijk en overzichtelijk resultaat.</p>
          </div>
          <div class="tile">
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
            <h3>Meer voor jezelf en thuis</h3>
            <p>Betaal minder premie voor je uitvaartverzekering en houd meer over voor de leuke dingen in het leven.</p>
          </div>
          <div class="tile">
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <h3>100% veilig en onafhankelijk</h3>
            <p>Direct vergelijken zonder gegevens op te geven. Je sluit altijd veilig af op de website van de verzekeraar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head-row">
        <div class="section-head">
          <h2 class="section-title">Meest gelezen uit de kennisbank</h2>
          <p class="section-sub">Alles over uitvaarten, polissen en kosten &mdash; in begrijpelijke taal.</p>
        </div>
        <a class="btn btn-ghost" href="/kennisbank/">Naar de kennisbank</a>
      </div>
      <PostGrid posts={kennisbank} kicker={false} showDate={false} />
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="tint">
      <div class="wrap">
        <div class="section-head-row">
          <div class="section-head">
            <h2 class="section-title">{reviews.length} verzekeraars beoordeeld</h2>
            <p class="section-sub">Premies, dekking, voorwaarden en klantervaringen per aanbieder.</p>
          </div>
          <a class="btn btn-ghost" href="/reviews/">Alle reviews</a>
        </div>
        <div class="pills">
          {reviews.slice(0, 22).map((r) => (
            <a href={`/${r.id}/`}>{r.id.split('/').pop()?.replace(/-/g, ' ')}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  {blogPosts.length > 0 && (
    <section>
      <div class="wrap">
        <div class="section-head-row">
          <div class="section-head">
            <h2 class="section-title">Laatste artikelen</h2>
            <p class="section-sub">Nieuws en achtergrond rondom uitvaarten en uitvaartverzekeringen.</p>
          </div>
          <a class="btn btn-ghost" href="/blog/">Alle artikelen</a>
        </div>
        <PostGrid posts={blogPosts} kicker={false} />
      </div>
    </section>
  )}

  {steden.length > 0 && (
    <section class="tint">
      <div class="wrap">
        <div class="section-head">
          <h2 class="section-title">Begrafenisondernemer in jouw stad</h2>
          <p class="section-sub">Vergelijk uitvaartondernemers en tarieven per gemeente.</p>
        </div>
        <div class="pills">
          {steden.map((s) => (
            <a href={`/${s.id}/`}>{s.id.split('/').pop()?.replace(/-/g, ' ')}</a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
