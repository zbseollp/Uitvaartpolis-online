---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import sections from '../data/kennisbank.json';

const all = await getCollection('blog');
const byId = new Map(all.map((e) => [e.id, e]));

// Zes recentste losse artikelen (staan op de root, niet in de kennisbank-mappen).
const populair = all
  .filter((e) => !e.id.includes('/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

// Plaatsen waar een begrafenisondernemer te vinden is.
const plaatsen = all
  .filter((e) => e.id.startsWith('begrafenisondernemer/'))
  .map((e) => ({
    href: `/${e.id}/`,
    naam: e.data.title.replace(/^Begrafenisondernemer\s*/i, '').split(/[,|–—-]/)[0].trim(),
  }))
  .sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));

const groepen = sections.map((s) => ({
  ...s,
  artikelen: s.slugs
    .map((slug) => byId.get(`kennisbank/${slug}`))
    .filter(Boolean)
    .map((e) => ({ href: `/kennisbank/${e!.id.split('/').pop()}/`, titel: e!.data.title }))
    .sort((a, b) => a.titel.localeCompare(b.titel, 'nl')),
}));

const totaal = groepen.reduce((n, g) => n + g.artikelen.length, 0);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<BaseLayout
  title="Kennisbank - Uitvaartpolis-online.com"
  description="Alle informatiegidsen over uitvaarten, begrafenissen en uitvaartverzekeringen op één plek."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span>/</span><span style="opacity:1;color:#a9c1cf">Kennisbank</span></p>
      <h1>Alles rondom een uitvaart</h1>
      <p>{totaal} informatiegidsen, geordend per onderwerp. Zoek hieronder of blader per thema.</p>
    </div>
  </section>

  <section class="kb-tools">
    <div class="wrap">
      <label class="kb-search">
        <span class="sr-only">Zoek in de kennisbank</span>
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="2" />
          <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input type="search" id="kb-q" placeholder={`Zoek in ${totaal} artikelen…`} autocomplete="off" />
      </label>
      <nav class="kb-jump" aria-label="Ga direct naar">
        {groepen.map((g) => (
          <a href={`#${g.id}`}>{g.name}<span>{g.id === 'begrafenisondernemer' ? plaatsen.length : g.artikelen.length}</span></a>
        ))}
      </nav>
      <p class="kb-count" id="kb-count" role="status" hidden></p>
    </div>
  </section>

  <section class="kb-body">
    <div class="wrap">
      {groepen.map((g) => (
        <section class="kb-group" id={g.id} data-group>
          <div class="kb-group-head">
            <div>
              <h2>{g.name}</h2>
              <p>{g.intro}</p>
            </div>
            <a class="kb-guide" href={g.guide}>Naar de gids <span aria-hidden="true">&rarr;</span></a>
          </div>

          {g.id === 'begrafenisondernemer' ? (
            <div class="kb-places">
              {plaatsen.map((p) => (
                <a class="kb-place" href={p.href} data-item data-t={p.naam.toLowerCase()}>{p.naam}</a>
              ))}
            </div>
          ) : (
            <ul class="kb-list">
              {g.artikelen.map((a) => (
                <li data-item data-t={a.titel.toLowerCase()}>
                  <a href={a.href}>{a.titel}</a>
                </li>
              ))}
            </ul>
          )}
          <p class="kb-empty" hidden>Geen artikelen in dit onderwerp die op je zoekopdracht passen.</p>
        </section>
      ))}

      <section class="kb-group kb-recent">
        <div class="kb-group-head">
          <div>
            <h2>Populaire artikelen</h2>
            <p>De meest recent gepubliceerde artikelen op Uitvaartpolis-online.</p>
          </div>
        </div>
        <div class="kb-cards">
          {populair.map((p) => (
            <a class="kb-card" href={`/${p.id}/`}>
              <time datetime={p.data.pubDate.toISOString().slice(0, 10)}>{fmt(p.data.pubDate)}</time>
              <h3>{p.data.title}</h3>
              {p.data.description && <p>{p.data.description}</p>}
            </a>
          ))}
        </div>
      </section>

      <aside class="kb-cta">
        <div>
          <h2>Staat je vraag er niet bij?</h2>
          <p>Vergelijk direct de uitvaartverzekeraars, of laat ons weten welke informatie je mist.</p>
        </div>
        <div class="kb-cta-actions">
          <a class="btn" href="/#vergelijken">Start met vergelijken</a>
          <a class="btn btn-ghost" href="/contact/#form_contactpageform">Meld ons welke info je mist</a>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      var q = document.getElementById('kb-q');
      var count = document.getElementById('kb-count');
      if (!q) return;
      var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
      var items = Array.prototype.slice.call(document.querySelectorAll('[data-item]'));

      function apply() {
        var term = q.value.trim().toLowerCase();
        var hits = 0;
        items.forEach(function (el) {
          var show = !term || el.getAttribute('data-t').indexOf(term) !== -1;
          el.hidden = !show;
          if (show) hits++;
        });
        groups.forEach(function (g) {
          var visible = g.querySelectorAll('[data-item]:not([hidden])').length;
          var empty = g.querySelector('.kb-empty');
          if (empty) empty.hidden = !term || visible > 0;
          g.hidden = !!term && visible === 0;
        });
        if (!term) {
          count.hidden = true;
        } else {
          count.hidden = false;
          count.textContent = hits === 0
            ? 'Geen artikelen gevonden voor “' + q.value.trim() + '”.'
            : hits + (hits === 1 ? ' artikel' : ' artikelen') + ' gevonden.';
        }
      }
      q.addEventListener('input', apply);
      q.addEventListener('search', apply);
    })();
  </script>
</BaseLayout>
