---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getBlogIndexPosts } from '../../lib/posts';

const posts = await getBlogIndexPosts();
---

<BaseLayout
  title="Blog over uitvaart en uitvaartverzekeringen | Uitvaartpolis-online.com"
  description="Nieuws, achtergrond en praktische tips over uitvaarten, uitvaartverzekeringen en het regelen van een afscheid."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Blog</h1>
      <p>{posts.length} artikelen over uitvaarten, verzekeringen en alles wat daarbij komt kijken. Meest recente eerst.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <PostGrid posts={posts} />
    </div>
  </section>
</BaseLayout>
